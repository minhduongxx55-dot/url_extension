{
  "name": "url-storage-server",
  "packageManager": "pnpm@10.0.0",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @workspace/dashboard run build && pnpm --filter @workspace/api-server run build",
